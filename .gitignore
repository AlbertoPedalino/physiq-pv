# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files
*.csv
*.xlsx
*.xls
*.parquet
*.nc
*.hdf5
*.h5

# Data files (large/generated — keep folder structure)
data/*
!data/.gitkeep

