# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# CDS credentials belong in ~/.cdsapirc, never in the repository
.cdsapirc
.cdsapirc.*

# Data files
*.csv
*.xlsx
*.xls
*.parquet
*.nc
*.hdf5
*.h5

# Data files (large/generated — keep folder structure)
data/*
!data/.gitkeep

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*.npz

# Experiment outputs, run artifacts and W&B logs (never commit)
outputs/
wandb/
checkpoints/
.analysis*/

# Notebooks: track only explicitly committed analyses (figures go to outputs/)
notebooks/*
!notebooks/mtgflow_spatiotemporal_anomaly_heatmaps.ipynb
!notebooks/pvgis_sde_pipeline.ipynb
!notebooks/mtgflow_pointwise_posthoc_sdenet.ipynb
!notebooks/stgan_pointwise_posthoc_sdenet.ipynb
!notebooks/stgan_input_target_cases_sdenet.ipynb
!notebooks/spatial_anomaly_comparison_mtgflow_stgan.ipynb
!notebooks/anomaly_threshold_sensitivity_mtgflow_stgan.ipynb
!notebooks/stgan_cnn_pvgis_workflow.ipynb
!notebooks/era5_anomaly_cube_analysis.ipynb
